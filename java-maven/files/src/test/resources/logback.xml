<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Discard logback's own config status output (nested <if> warnings). -->
    <statusListener class="ch.qos.logback.core.status.NopStatusListener" />

    <if condition='property("CONSOLE_LOGGING").contains("ON")'>
        <then>
            <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
                <encoder>
                    <pattern>%date{yyy-MM-dd'T'HH:mm:ss.SSSXXX, UTC} ${PROJECT:-debug}%replace(%msg){'[\r\n]+', ' '}%n</pattern>
                </encoder>
            </appender>
        </then>
    </if>

    <if condition='property("FILE_LOGGING").contains("ON")'>
        <then>
            <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
                <!-- Threshold, not LevelFilter: the previous DEBUG-only filter denied
                     every INFO/WARN/ERROR event, including the picatinny banner. -->
                <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
                    <level>DEBUG</level>
                </filter>
                <encoder>
                    <pattern>%date{yyy-MM-dd'T'HH:mm:ss.SSSXXX, UTC} ${PROJECT:-debug}%replace(%msg){'[\r\n]+', ' '}%n</pattern>
                </encoder>
                <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                    <fileNamePattern>target/gatling-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
                    <maxFileSize>100MB</maxFileSize>
                    <maxHistory>5</maxHistory>
                    <totalSizeCap>500MB</totalSizeCap>
                </rollingPolicy>
            </appender>

            <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
                <appender-ref ref="FILE"/>
            </appender>
        </then>
    </if>

    <!-- Picatinny startup banner / diagnostics. Since picatinny 1.23.0 these are emitted
         through SLF4J (logger org.galaxio.gatling.diagnostics) instead of stdout, so without
         this binding the root level below would swallow them. The whole block arrives as one
         log event: %msg%n prints it verbatim and keeps the ASCII box aligned, and
         additivity="false" stops it also printing through the prefixed root appenders.
         Whether the blocks are produced at all is controlled by
         picatinny.startup.banner.enabled / picatinny.diagnostics.enabled in simulation.conf;
         CONSOLE_LOGGING=OFF suppresses them here like any other console output, and
         FILE_LOGGING=ON archives them alongside the run they describe. Logback rejects <if>
         nested inside <logger>, so each reachable combination selects a whole element. -->
    <if condition='!property("CONSOLE_LOGGING").contains("OFF")'>
        <then>
            <appender name="BANNER" class="ch.qos.logback.core.ConsoleAppender">
                <encoder>
                    <pattern>%msg%n</pattern>
                </encoder>
            </appender>

            <if condition='property("FILE_LOGGING").contains("ON")'>
                <then>
                    <logger name="org.galaxio.gatling.diagnostics" level="INFO" additivity="false">
                        <appender-ref ref="BANNER"/>
                        <appender-ref ref="ASYNC_FILE"/>
                    </logger>
                </then>
                <else>
                    <logger name="org.galaxio.gatling.diagnostics" level="INFO" additivity="false">
                        <appender-ref ref="BANNER"/>
                    </logger>
                </else>
            </if>
        </then>
        <else>
            <if condition='property("FILE_LOGGING").contains("ON")'>
                <then>
                    <logger name="org.galaxio.gatling.diagnostics" level="INFO" additivity="false">
                        <appender-ref ref="ASYNC_FILE"/>
                    </logger>
                </then>
            </if>
        </else>
    </if>

    <logger name="io.gatling.http.engine.response.DefaultStatsProcessor" level="WARN"/>

    <root level="${ROOT_LOGGING_LEVEL:-ERROR}">
        <if condition='property("CONSOLE_LOGGING").contains("ON")'>
            <then>
                <appender-ref ref="CONSOLE"/>
            </then>
        </if>
        <if condition='property("FILE_LOGGING").contains("ON")'>
            <then>
                <appender-ref ref="ASYNC_FILE"/>
            </then>
        </if>
        <if condition='property("GRAYLOG_LOGGING").contains("ON")'>
            <then>
                <appender-ref ref="ASYNC_GELF"/>
            </then>
        </if>
    </root>

</configuration>